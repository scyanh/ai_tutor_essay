# ==============================================================================
# Configuración del Entorno - Tutor de Ensayos ADK
# ==============================================================================

# 1. Configuración del Modelo Gemini / Google GenAI
# Si usas Google AI Studio (Desarrollo local):
GEMINI_API_KEY=
# Si usas Vertex AI en Google Cloud:
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-3.8-flash

# 2. Configuración de Base de Datos PostgreSQL (obligatoria; no hay base de respaldo)
# Desde tu máquina, a través del Cloud SQL Auth Proxy:
DATABASE_URL=postgresql+psycopg2://usuario:contraseña@127.0.0.1:5432/sharon_education

# 3. Google Cloud Storage (GCS)
GCS_BUCKET_NAME=sharon_storage

# 4. Vertex AI Search (Agent Platform Search / RAG)
DATA_STORE_REGION=global
DATA_STORE_COLLECTION=default_collection
DATA_STORE_ID=essay-tutor-datastore
